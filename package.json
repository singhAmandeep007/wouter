{
  "name": "wouter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.12.x",
    "npm": "11.6.x"
  },
  "scripts": {
    "dev": "vite",
    "codegen": "npm run codegen:types && npm run codegen:zod",
    "codegen:types": "openapi-typescript src/shared/api/openapi.yaml -o src/shared/api/generated/schema.d.ts",
    "codegen:zod": "typed-openapi src/shared/api/openapi.yaml --runtime zod --schemas-only -o src/shared/api/generated/zod.ts",
    "build": "tsc -b && vite build",
    "build:mock": "VITE_ENABLE_MSW=true npm run build",
    "analyze": "ANALYZE=true npm run build",
    "budget:bundle": "node scripts/check-bundle-budget.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "preview": "vite preview",
    "preview:mock": "npm run build:mock && vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@xyflow/react": "^12.10.1",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "lodash-es": "^4.17.23",
    "msw": "^2.12.10",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "wouter": "^3.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.54.2",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "rollup-plugin-visualizer": "^7.0.0",
    "typed-openapi": "^4.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.0-beta.13",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "vite": "^8.0.0-beta.13"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
